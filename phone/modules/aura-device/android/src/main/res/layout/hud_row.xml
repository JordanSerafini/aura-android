<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aura HUD » : un élément de la liste. Barre de couleur (gravité), heure, titre, détail ; appui = l'app au bon
     endroit ; jusqu'à 3 boutons de 48 dp (RELANCER, RÉPARE, MASQUER 24H, FAIT, +1H, TRAITÉ, ÉCARTER). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:paddingTop="3dp"
  android:paddingBottom="3dp">

  <TextView
    android:id="@+id/hud_row_bar"
    android:layout_width="3dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="8dp"
    android:background="@color/hud_violet" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">
    <LinearLayout
      android:id="@+id/hud_row_main"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="40dp"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/hud_row_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="6dp"
          android:fontFamily="monospace"
          android:textColor="@color/hud_cyan"
          android:textSize="12.5sp"
          android:visibility="gone" />
        <TextView
          android:id="@+id/hud_row_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="@color/hud_text"
          android:textSize="13.5sp"
          android:textStyle="bold" />
      </LinearLayout>
      <TextView
        android:id="@+id/hud_row_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/hud_muted"
        android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/hud_row_btns"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="horizontal">
      <TextView android:id="@+id/hud_b1" style="@style/HudBtn" />
      <TextView android:id="@+id/hud_b2" style="@style/HudBtn" />
      <TextView android:id="@+id/hud_b3" style="@style/HudBtn" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
