<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aura HUD », format moyen (4x2, AuraHudWidget.kt) : noyau, prochain RDV, fraîcheur, ↻ ;
     1 à 3 lignes « À traiter » (selon la hauteur, 1.9.0) avec leur bouton simple (FAIT, TRAITÉ). Sert aussi d'aperçu et de repli. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hud_bg"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="8dp"
  android:paddingEnd="10dp"
  android:paddingBottom="8dp">
  <!-- barre de santé (1.9.0) : le pire de la gravité des alertes et de l'état du PC -->
  <TextView
    android:id="@+id/hud_health"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_marginBottom="6dp"
    android:background="@color/hud_muted"
    android:importantForAccessibility="no" />
  <LinearLayout
    android:id="@+id/hud_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hud_core"
      android:layout_width="46dp"
      android:layout_height="46dp"
      android:background="@drawable/hud_core_inconnu"
      android:fontFamily="sans-serif-condensed"
      android:gravity="center"
      android:text="–"
      android:textColor="@color/hud_text"
      android:textSize="19sp"
      android:textStyle="bold" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/hud_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="En attente du PC…"
        android:textColor="@color/hud_text"
        android:textSize="14sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/hud_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hud_cyan"
        android:textSize="11.5sp"
        android:visibility="gone" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/hud_fresh"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/hud_muted"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/hud_weather"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:maxLines="1"
          android:textColor="@color/hud_muted"
          android:textSize="11sp" />
        <TextClock
          android:id="@+id/hud_clock"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="monospace"
          android:format12Hour="HH:mm"
          android:format24Hour="HH:mm"
          android:maxLines="1"
          android:textColor="@color/hud_violet"
          android:textSize="11sp" />
      </LinearLayout>
    </LinearLayout>
    <ImageView
      android:id="@+id/hud_mic"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="Parler à Aura"
      android:padding="13dp"
      android:src="@drawable/hud_mic" />
    <TextView
      android:id="@+id/hud_refresh"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="Actualiser"
      android:gravity="center"
      android:text="↻"
      android:textColor="@color/hud_violet"
      android:textSize="22sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/hud_l1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hud_l1_t"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:ellipsize="end"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:textColor="@color/hud_text"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/hud_l1_b"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/hud_btn"
      android:gravity="center"
      android:minWidth="64dp"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:textColor="@color/hud_green"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/hud_l2"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hud_l2_t"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:ellipsize="end"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:textColor="@color/hud_text"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/hud_l2_b"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/hud_btn"
      android:gravity="center"
      android:minWidth="64dp"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:textColor="@color/hud_green"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/hud_l3"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hud_l3_t"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="?android:attr/selectableItemBackground"
      android:ellipsize="end"
      android:gravity="center_vertical"
      android:maxLines="1"
      android:textColor="@color/hud_text"
      android:textSize="13sp" />
    <TextView
      android:id="@+id/hud_l3_b"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:layout_marginStart="6dp"
      android:background="@drawable/hud_btn"
      android:gravity="center"
      android:minWidth="64dp"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:textColor="@color/hud_green"
      android:textSize="12sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
