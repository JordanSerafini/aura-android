<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Aura HUD », petit format (2x2, AuraHudWidget.kt) : noyau, prochain rendez-vous, fraîcheur. Appui : l'app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hud_head"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hud_bg"
  android:orientation="vertical"
  android:padding="12dp">
  <!-- barre de santé (1.9.0) : le pire de la gravité des alertes et de l'état du PC -->
  <TextView
    android:id="@+id/hud_health"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_marginBottom="6dp"
    android:background="@color/hud_muted"
    android:importantForAccessibility="no" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:id="@+id/hud_core"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:background="@drawable/hud_core_inconnu"
      android:fontFamily="sans-serif-condensed"
      android:gravity="center"
      android:text="–"
      android:textColor="@color/hud_text"
      android:textSize="22sp"
      android:textStyle="bold" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-condensed"
          android:letterSpacing="0.2"
          android:text="AURA"
          android:textColor="@color/hud_violet"
          android:textSize="12sp"
          android:textStyle="bold" />
      <TextView
        android:id="@+id/hud_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/hud_muted"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/hud_next"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="En attente du PC…"
    android:textColor="@color/hud_text"
    android:textSize="13sp" />

  <TextView
    android:id="@+id/hud_fresh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/hud_muted"
    android:textSize="11sp" />
</LinearLayout>
