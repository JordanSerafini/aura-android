# Copy these into your shell environment (or an untracked .env you source yourself) before building.
# All values below are placeholders.
AURA_MOBILE_DEVICE_TOKEN=replace-with-a-device-token-from-your-server
AURA_BRIDGE_URL=wss://example.invalid/ws
AURA_PWA_URL=https://example.invalid/app/

# Release signing (only needed for assembleRelease)
AURA_KEYSTORE_FILE=/path/to/your-release.jks
AURA_KEYSTORE_ALIAS=aura
AURA_MOBILE_KEYSTORE_PASS=replace-me
